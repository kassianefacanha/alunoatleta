# Information about the environment configuration for the application
NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
TERMS_VERSION=1.0

# Database connection string for MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/alunoatleta
JWT_SECRET=
JWT_REFRESH_SECRET=

# Test account credentials for `npm run seed` (passwords must have 12+ characters)
ADMIN_EMAIL=
ADMIN_PASSWORD=
TEACHER_EMAIL=
TEACHER_PASSWORD=
TEST_STUDENT_EMAIL=
TEST_STUDENT_PASSWORD=

# Configuration for Cloudflare R2 storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=aluno-atleta-uploads
R2_ENDPOINT=
